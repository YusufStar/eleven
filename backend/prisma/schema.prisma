generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  githubProfile UserGithubProfile?
  dmChatsAsParticipant1 Chat[] @relation("DMParticipant1")
  dmChatsAsParticipant2 Chat[] @relation("DMParticipant2")
  messagesSent Message[]
  messageReactions MessageReaction[]
  chatReads        ChatRead[]

  @@unique([email])
  @@map("user")
}

// Per-user GitHub link (profile-level). Used to show "GitHub connected" in team list.
model UserGithubProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_github_profile")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  plan       Plan       @default(FREE)
  paidAt     DateTime?  // set when one-time payment succeeds
  activities Activity[]
  projects   Project[]
  tasks      Task[]
  sprints    Sprint[]
  aiReports  AiReport[]
  orgChat    Chat?      @relation("OrgChat")
  meetings      Meeting[]
  notifications Notification[]

  githubConnection OrganizationGithubConnection?

  @@unique([slug])
  @@map("organization")
}

// Organization's main GitHub account (company account). One per organization.
model OrganizationGithubConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubUserId   String
  githubLogin    String
  avatarUrl      String?
  accessToken    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("organization_github_connection")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Presence & profile (team page)
  statusEmoji String?
  statusText  String?
  workingOn   String?
  timezone    String?
  skills      String[]  @default([])
  lastSeenAt  DateTime?

  activityLogs    Activity[]
  assignedTasks   Task[] @relation("AssignedTasks")
  createdTasks    Task[] @relation("CreatedTasks")
  taskComments    TaskComment[]
  watchedTasks    TaskWatcher[]
  timeEntries     TimeEntry[]
  projectMembers  ProjectMember[]
  projectFilesUploaded ProjectFile[]
  createdMeetings    Meeting[]            @relation("CreatedMeetings")
  meetingInvites     MeetingParticipant[]
  meetingAttendance  MeetingAttendance[]  @relation("MeetingAttendance")
  meetingRecordings  MeetingRecording[]   @relation("MeetingRecordings")
  notifications      Notification[]       @relation("NotificationRecipient")
  actedNotifications Notification[]       @relation("NotificationActor")
  notificationPreference NotificationPreference?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Audit log: who did what (create/update/delete/comment/...) on which entity. List endpoints are not logged.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  action    ActivityAction
  entityType ActivityEntityType
  entityId  String
  entityTitle String?  // optional display/search label (e.g. task title, project name)
  metadata  Json?     // optional details (e.g. changed fields for UPDATE)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([organizationId, memberId])
  @@index([organizationId, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityTitle])
  @@map("activities")
}

model Project {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  description         String?
  // Links: array of { title: string, url: string } (e.g. Figma Dev, Github, etc.)
  links               Json?        @default("[]")
  // GitHub repo linked to this project (from org's connected GitHub account)
  githubRepoFullName  String?      // e.g. "owner/repo"
  githubRepoUrl       String?      // e.g. "https://github.com/owner/repo"

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]
  members     ProjectMember[]
  files       ProjectFile[]
  milestones  Milestone[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

// Project members: only assigned members can access project data. Selected from org members.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("project_members")
}

// Project files/documents (drive-like)
model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  // Virtual folder path, e.g. "/" or "/design/specs". No Folder model needed.
  folder      String   @default("/")
  // Previous versions: [{ fileUrl, fileSize, uploadedById, uploadedAt }]
  versionHistory Json  @default("[]")
  uploadedById String?
  uploadedBy  Member?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, folder])
  @@map("project_files")
}

// ─── Sprints & Milestones ───────────────────────
model Sprint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  goal           String?
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks Task[]

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@map("sprints")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  tasks Task[]

  @@index([projectId])
  @@map("milestones")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  detailsMarkdown String?   // Rich markdown content (Task details), supports images

  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  labels      String[]     @default([])

  dueAt       DateTime?
  completedAt DateTime?

  // Estimation & time tracking
  estimate         Int? // story points
  timeSpentMinutes Int  @default(0) // denormalized sum of TimeEntry.minutes

  assigneeId String?
  assignee   Member? @relation("AssignedTasks", fields: [assigneeId], references: [id])

  creatorId String?
  creator   Member? @relation("CreatedTasks", fields: [creatorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  parentTaskId String?
  parentTask   Task?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[] @relation("SubTasks")

  attachments TaskAttachment[]
  comments    TaskComment[]
  watchers    TaskWatcher[]
  timeEntries TimeEntry[]
  // Dependencies: this task is blocked until `dependsOn` tasks complete
  dependsOn     TaskDependency[] @relation("DependsOn")
  dependedOnBy  TaskDependency[] @relation("DependedOnBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, projectId])
  @@index([organizationId, sprintId])
  @@map("tasks")
}

model TaskAttachment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

model TaskComment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

model TaskWatcher {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, memberId])
  @@index([memberId])
  @@map("task_watchers")
}

// task depends on dependsOn (dependsOn must complete first)
model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  task        Task   @relation("DependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task   @relation("DependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model TimeEntry {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  minutes  Int
  note     String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([memberId])
  @@map("time_entries")
}

// ─── Chat ───────────────────────────────────────
// Chat id in URL: for org = organizationId, for DM = "participant1Id-participant2Id" (sorted)
model Chat {
  id             String   @id // URL slug: orgId or "userId1-userId2"
  type           ChatType
  organizationId String?  @unique
  organization   Organization? @relation("OrgChat", fields: [organizationId], references: [id], onDelete: Cascade)
  participant1Id String?
  participant2Id String?
  participant1   User?    @relation("DMParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User?    @relation("DMParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]
  reads          ChatRead[]
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([organizationId])
  @@index([participant1Id, participant2Id])
  @@map("chats")
}

model Message {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderUserId String
  sender      User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  content     String?  // optional when message is media-only
  medias      MessageMedia[]

  // Threads: replies reference the thread root message
  replyToId String?
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("Replies")

  mentionUserIds String[] @default([])
  reactions      MessageReaction[]

  pinnedAt  DateTime?
  editedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([chatId, pinnedAt])
  @@index([replyToId])
  @@index([senderUserId])
  @@map("messages")
}

model MessageMedia {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String  // media link (e.g. S3/R2)
  mimetype  String  // e.g. image/png, video/mp4, application/pdf
  size      Int     // bytes

  @@index([messageId])
  @@map("message_medias")
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// Read receipts / unread counts: last time a user read a chat
model ChatRead {
  id         String   @id @default(cuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_reads")
}

// ─── Meetings ────────────────────────────────────
model Meeting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code     String    @unique // room slug used in /meet/<code>
  title    String
  startsAt DateTime
  endsAt   DateTime?
  isPublic Boolean   @default(false) // open to every member of the organization

  createdById String
  createdBy   Member @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: Cascade)

  participants MeetingParticipant[]
  attendance   MeetingAttendance[]
  recordings   MeetingRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@map("meetings")
}

// One row per join session — a rejoin creates a new row.
model MeetingAttendance {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation("MeetingAttendance", fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@index([meetingId])
  @@index([memberId])
  @@map("meeting_attendance")
}

model MeetingRecording {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  url         String
  sizeBytes   Int?
  durationSec Int?
  createdById String
  createdBy   Member   @relation("MeetingRecordings", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([meetingId])
  @@map("meeting_recordings")
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([memberId])
  @@map("meeting_participants")
}

// ─── Notifications ───────────────────────────────
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   Member  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Member? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type     NotificationType
  // Grouping bucket for filters/preferences: "task" | "mention" | "project" | "meeting" | "system"
  category String           @default("system")
  // "low" | "normal" | "high"
  priority String           @default("normal")
  title  String
  body   String?
  link   String? // in-app path, e.g. /dashboard/tasks or /meet/<code>
  readAt       DateTime?
  archivedAt   DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, archivedAt])
  @@index([organizationId])
  @@map("notifications")
}

// Per-member notification preferences. categories Json shape:
// { task: { inApp: true, email: true }, mention: {...}, project: {...}, meeting: {...}, system: {...} }
model NotificationPreference {
  id       String @id @default(cuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  categories      Json    @default("{}")
  emailEnabled    Boolean @default(true)
  pushEnabled     Boolean @default(false)
  quietHoursStart Int? // hour 0-23, in member timezone
  quietHoursEnd   Int?
  digest          String  @default("off") // "off" | "daily" | "weekly"

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── AI Reports ──────────────────────────────────
model AiReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind        AiReportKind
  title       String
  content     String // markdown
  metrics     Json   @default("{}") // structured numbers used in the report
  model       String?
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@index([organizationId, kind, createdAt])
  @@map("ai_reports")
}

// ─── Enums ───────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_COMMENT
  MENTION
  PROJECT_MEMBER_ADDED
  PROJECT_FILE_ADDED
  MEETING_INVITED
  SPRINT_STARTED
  GENERIC
}

enum ChatType {
  ORG
  DM
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  COMMENT
  ASSIGN
  COMPLETE
  MENTION
}

enum ActivityEntityType {
  PROJECT
  TASK
  SPRINT
  MILESTONE
  PROJECT_FILE
  TASK_ATTACHMENT
  PROJECT_MEMBER
  MESSAGE
  MEETING
  MEMBER
  AI_REPORT
}

enum Plan {
  FREE
  PROFESSIONAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiReportKind {
  MINI
  MEDIUM
  HIGH
}
