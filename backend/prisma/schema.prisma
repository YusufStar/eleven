generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  githubProfile UserGithubProfile?
  dmChatsAsParticipant1 Chat[] @relation("DMParticipant1")
  dmChatsAsParticipant2 Chat[] @relation("DMParticipant2")
  messagesSent Message[]

  @@unique([email])
  @@map("user")
}

// Per-user GitHub link (profile-level). Used to show "GitHub connected" in team list.
model UserGithubProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_github_profile")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  plan       Plan       @default(FREE)
  paidAt     DateTime?  // set when one-time payment succeeds
  contacts   Contact[]
  deals      Deal[]
  pipelines  Pipeline[]
  activities Activity[]
  projects   Project[]
  tasks      Task[]
  orgChat    Chat?      @relation("OrgChat")
  meetings      Meeting[]
  notifications Notification[]

  githubConnection OrganizationGithubConnection?

  @@unique([slug])
  @@map("organization")
}

// Organization's main GitHub account (company account). One per organization.
model OrganizationGithubConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubUserId   String
  githubLogin    String
  avatarUrl      String?
  accessToken    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("organization_github_connection")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  ownedContacts   Contact[]
  ownedDeals      Deal[]
  activityLogs    Activity[]
  assignedTasks   Task[] @relation("AssignedTasks")
  createdTasks    Task[] @relation("CreatedTasks")
  projectMembers  ProjectMember[]
  projectFilesUploaded ProjectFile[]
  createdMeetings    Meeting[]            @relation("CreatedMeetings")
  meetingInvites     MeetingParticipant[]
  notifications      Notification[]       @relation("NotificationRecipient")
  actedNotifications Notification[]       @relation("NotificationActor")

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Temel bilgiler
  type   ContactType   @default(PERSON)
  status ContactStatus @default(LEAD)
  source ContactSource @default(MANUAL)
  avatar String?       // profile picture for PERSON, logo for COMPANY

  // Kişi bilgileri
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String? // "Pazarlama Müdürü" gibi unvan

  // Şirket bilgileri (type = COMPANY ise bunlar dolu)
  companyName   String?
  website       String?
  industry      String?
  employeeCount Int?

  // Şirket-Kişi ilişkisi
  // Bir kişi bir şirkete bağlı olabilir
  companyId String?
  company   Contact?  @relation("CompanyPersons", fields: [companyId], references: [id])
  employees Contact[] @relation("CompanyPersons")

  // Adres
  country String?
  city    String?
  address String?

  // Sorumlu kişi (hangi ekip üyesi takip ediyor)
  ownerId String?
  owner   Member? @relation(fields: [ownerId], references: [id])

  // Ek bilgiler
  notes        String?
  tags         String[] @default([])
  customFields Json?    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  deals      Deal[]
  tasks      Task[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([email])
  @@map("contacts")
}

// Audit log: who did what (create/update/delete/view) on which entity. List endpoints are not logged.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  action    ActivityAction
  entityType ActivityEntityType
  entityId  String
  entityTitle String?  // optional display/search label (e.g. contact name, deal title)
  metadata  Json?     // optional details (e.g. changed fields for UPDATE)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([organizationId, memberId])
  @@index([organizationId, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityTitle])
  @@map("activities")
}

model Pipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages Stage[]
  deals  Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  color      String?

  deals Deal[]

  @@index([pipelineId])
  @@map("stages")
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title         String
  value         Decimal?   @db.Decimal(15, 2)
  currency      String     @default("TRY")
  probability   Int?       @default(50)
  expectedClose DateTime?
  status        DealStatus @default(OPEN)
  lostReason    String? // kaybedildiyse neden

  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])

  ownerId String?
  owner   Member? @relation(fields: [ownerId], references: [id])

  customFields Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@map("deals")
}

model Project {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  description         String?
  // Links: array of { title: string, url: string } (e.g. Figma Dev, Github, etc.)
  links               Json?        @default("[]")
  // GitHub repo linked to this project (from org's connected GitHub account)
  githubRepoFullName  String?      // e.g. "owner/repo"
  githubRepoUrl       String?      // e.g. "https://github.com/owner/repo"

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]
  members     ProjectMember[]
  files       ProjectFile[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

// Project members: only assigned members can access project data. Selected from org members.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("project_members")
}

// Project files/documents (drive-like)
model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String?
  fileSize    Int?
  uploadedById String?
  uploadedBy  Member?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("project_files")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  detailsMarkdown String?   // Rich markdown content (Task details), supports images

  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  dueAt       DateTime?
  completedAt DateTime?

  assigneeId String?
  assignee   Member? @relation("AssignedTasks", fields: [assigneeId], references: [id])

  creatorId String?
  creator   Member? @relation("CreatedTasks", fields: [creatorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  parentTaskId String?
  parentTask   Task?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[] @relation("SubTasks")

  attachments TaskAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, projectId])
  @@map("tasks")
}

model TaskAttachment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// ─── Chat ───────────────────────────────────────
// Chat id in URL: for org = organizationId, for DM = "participant1Id-participant2Id" (sorted)
model Chat {
  id             String   @id // URL slug: orgId or "userId1-userId2"
  type           ChatType
  organizationId String?  @unique
  organization   Organization? @relation("OrgChat", fields: [organizationId], references: [id], onDelete: Cascade)
  participant1Id String?
  participant2Id String?
  participant1   User?    @relation("DMParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User?    @relation("DMParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([organizationId])
  @@index([participant1Id, participant2Id])
  @@map("chats")
}

model Message {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderUserId String
  sender      User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  content     String?  // optional when message is media-only
  medias      MessageMedia[]
  createdAt   DateTime @default(now())

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

model MessageMedia {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String  // media link (e.g. S3/R2)
  mimetype  String  // e.g. image/png, video/mp4, application/pdf
  size      Int     // bytes

  @@index([messageId])
  @@map("message_medias")
}

// ─── Meetings ────────────────────────────────────
model Meeting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code     String    @unique // room slug used in /meet/<code>
  title    String
  startsAt DateTime
  endsAt   DateTime?
  isPublic Boolean   @default(false) // open to every member of the organization

  createdById String
  createdBy   Member @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: Cascade)

  participants MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@map("meetings")
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, memberId])
  @@index([memberId])
  @@map("meeting_participants")
}

// ─── Notifications ───────────────────────────────
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   Member  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Member? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type   NotificationType
  title  String
  body   String?
  link   String? // in-app path, e.g. /dashboard/tasks or /meet/<code>
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

// ─── Enums ───────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  DEAL_STAGE_CHANGED
  DEAL_WON
  PROJECT_MEMBER_ADDED
  MEETING_INVITED
  CONTACTS_IMPORTED
  GENERIC
}

enum ChatType {
  ORG
  DM
}

enum ContactType {
  PERSON
  COMPANY
}

enum ContactStatus {
  LEAD // potansiyel, henüz görüşülmedi
  PROSPECT // görüşme aşamasında
  CUSTOMER // aktif müşteri
  CHURNED // kaybedilmiş müşteri
  PARTNER // iş ortağı
}

enum ContactSource {
  MANUAL // elle eklendi
  CSV_IMPORT // toplu import
  WEB_FORM // web sitesi formu
  EMAIL // email entegrasyonu
  API // dış sistem
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  VIEW
}

enum ActivityEntityType {
  CONTACT
  DEAL
  PROJECT
  TASK
  PIPELINE
  STAGE
  PROJECT_FILE
  TASK_ATTACHMENT
  PROJECT_MEMBER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum Plan {
  FREE
  PROFESSIONAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
