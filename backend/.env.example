PORT=3333

DATABASE_URL="postgresql://user:password@localhost:5432/crm_db"
DATABASE_APP_URL="postgresql://app_user:app_password@localhost:5432/crm_db"

BETTER_AUTH_SECRET="at-least-32-characters-long-random-secret"
BETTER_AUTH_URL="http://localhost:3333"

FRONTEND_URL="http://localhost:3000"
# Backend public URL (for OAuth redirect_uri). Use same as BETTER_AUTH_URL in dev.
BACKEND_URL="http://localhost:3333"

# GitHub OAuth (organization connection + optional user account linking)
# Create OAuth App: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:3333/settings/github/callback (or your BACKEND_URL + /settings/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="your-email@gmail.com"

# Storage (Cloudflare R2)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_BASE_URL=https://your-cdn-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
